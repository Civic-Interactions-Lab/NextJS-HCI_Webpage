{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "pnpm",
      "runtimeArgs": ["dev"],
      "port": 3000,
      "autoPort": true
    },
    {
      "name": "Convex Dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["convex", "dev"],
      "port": 3210
    },
    {
      "name": "Flask Webhook",
      "runtimeExecutable": "python",
      "runtimeArgs": ["webhook/app.py"],
      "port": 9000
    }
  ]
}
