# Sanity CMS
# Public project ID from Sanity settings
NEXT_PUBLIC_SANITY_PROJECT_ID="abc123xy"
# Dataset name
NEXT_PUBLIC_SANITY_DATASET="hci-production"
# Server-only admin token \(never expose in client code\)
NEXT_PUBLIC_SANITY_API_ADMIN_TOKEN=sanity_admin_token_here

# Mapbox
# Public token for map rendering/geocoding
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoieW91ci11c2VyIiwiYSI6ImNpeGFtcGxlIn0.example

# Clerk Auth
# Frontend publishable key
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_example
# Backend secret key
CLERK_SECRET_KEY=sk_test_example

# Convex
# Deployment used by `npx convex dev`
CONVEX_DEPLOYMENT=dev:combative-lark-90
# Public Convex URL used by the client
NEXT_PUBLIC_CONVEX_URL=https://combative-lark-90.convex.cloud

# Deployment
# Shared secret used by GitHub webhook signature validation
WEBHOOK_SECRET=replace_with_a_long_random_secret
# GitHub repo allowed to trigger deployments
REPO_FULL_NAME=Civic-Interactions-Lab/NextJS-HCI_Webpage
# Branch that should deploy when pushed
REPO_BRANCH=main
# Absolute path to this repo on the server, used by the webhook container
HOST_REPO_DIR=/absolute/path/to/NextJS-HCI_Webpage
# Absolute path to the git common directory for this checkout.
# For a normal clone this is usually HOST_REPO_DIR/.git.
# For a git worktree this points at the parent repo's .git directory.
HOST_GIT_COMMON_DIR=/absolute/path/to/repo/.git
# Absolute host SSH directory used for git pulls from GitHub
HOST_SSH_DIR=/absolute/path/to/.ssh
# Host binding for the reverse proxy entrypoint
APP_HOST_BIND=127.0.0.1
APP_HOST_PORT=80
# Host binding for the separate webhook service
WEBHOOK_HOST_BIND=127.0.0.1
WEBHOOK_HOST_PORT=9001
